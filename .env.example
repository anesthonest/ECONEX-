# ==========================================
# ECONEX V26.0 ENVIRONMENT CONFIGURATION TEMPLATE
# Release: V26.0-UNIVERSAL-PLATFORM-ACTIVATION (Schema 24)
# Copy this file to `.env` for local development or inject via cloud secret manager.
# NEVER commit real `.env` files, API keys, private keys, or credentials.
# ==========================================

# 1. Environment Separation (DEVELOPMENT | AUTOMATED_TESTING | STAGING | PRODUCTION)
ECONEX_ENV="DEVELOPMENT"
NODE_ENV="development"
PORT="3000"
DISABLE_HMR="true"

# 2. Application & AI Services (Injected securely at runtime — never hardcode)
GEMINI_API_KEY="REPLACE_WITH_SERVER_SIDE_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
VITE_API_BASE_URL=""

# 3. Database & Persistence (PostgreSQL 16 target vs Local JSON WAL fallback)
# Leave DATABASE_URL / PGHOST unset in local preview; JSON WAL remains fail-closed authoritative.
DATABASE_URL=""
PGHOST=""
PGPORT="5432"
PGDATABASE="econex"
PGUSER=""
PG_POOL_MAX="10"
PG_SSL_MODE="require"
PG_WAL_ARCHIVE_ENABLED="false"

# 4. Private Document Vault & Storage (Local sandbox directory vs Cloud S3/GCS bucket)
V25_VAULT_DIR="data/v25_vault"
CLOUD_STORAGE_BUCKET=""
CLOUD_STORAGE_REGION="af-east-1"

# 5. External Production Integrations (Unprovisioned in Sandbox; Required for Staging/Production)
KAFKA_BROKERS=""
NATS_URL=""
HSM_PKCS11_MODULE_PATH=""
HSM_SLOT_PIN=""
AUDIT_WORM_S3_BUCKET=""
AUDIT_WORM_ENDPOINT=""
MOMO_PROVIDER_API_URL=""
MOMO_PROVIDER_API_KEY=""
AIRTEL_PROVIDER_API_URL=""
RTGS_GATEWAY_ENDPOINT=""
SMTP_HOST=""
AFRICASTALKING_API_KEY=""
WHATSAPP_BUSINESS_TOKEN=""
