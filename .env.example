# ==========================================
# ECONEX V19.0 ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` for local development or inject via hosting secret manager.
# NEVER commit real `.env` files, API keys, private keys, or credentials.
# ==========================================

# 1. Environment Separation (DEVELOPMENT | AUTOMATED_TESTING | STAGING | PRODUCTION)
ECONEX_ENV="DEVELOPMENT"
NODE_ENV="development"
PORT="3000"
DISABLE_HMR="true"

# 2. Application & AI Services (Injected securely at runtime — never hardcode)
GEMINI_API_KEY="REPLACE_WITH_SERVER_SIDE_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
VITE_API_BASE_URL=""

# 3. Database & Persistence (PostgreSQL 16 target vs Local JSON WAL fallback)
# Leave DATABASE_URL unset in local preview; JSON WAL remains fail-closed authoritative.
DATABASE_URL=""
PG_SSL_MODE="require"
PG_WAL_ARCHIVE_ENABLED="false"

# 4. External Production Integrations (Unprovisioned in Sandbox; Required for Staging/Production)
KAFKA_BROKERS=""
NATS_URL=""
HSM_PKCS11_MODULE_PATH=""
HSM_SLOT_PIN=""
AUDIT_WORM_S3_BUCKET=""
AUDIT_WORM_ENDPOINT=""
MOMO_PROVIDER_API_URL=""
MOMO_PROVIDER_API_KEY=""
AIRTEL_PROVIDER_API_URL=""
RTGS_GATEWAY_ENDPOINT=""
